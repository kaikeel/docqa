# Copy to .env and fill in. Never commit .env.
# Used with `docker run --env-file .env` or `set -a; . ./.env; set +a` in a shell.

# Required only for answers with evidence and for the full eval (the SDK reads it).
ANTHROPIC_API_KEY=

# Optional (defaults shown)
DOCQA_MODEL=claude-opus-5-5
DOCQA_EFFORT=low
DOCQA_TOP_K=5
DOCQA_MIN_COVERAGE=0.5
DOCQA_CHAT_MAX_MESSAGES=20
DOCQA_CHAT_MAX_CHARS=2000

# Paths: leave these commented out for Docker. The image already sets DOCQA_DB=/data/docqa.db
# and DOCQA_INGEST_ROOT=/app, and only /data is writable inside the container.
# Outside Docker the defaults are ./docqa.db and the current directory.
# DOCQA_DB=./docqa.db
# DOCQA_INGEST_ROOT=/path/to/your/documents
